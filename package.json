{
  "name": "hvb-sistema",
  "version": "0.27.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file=.env src/api/server.ts",
    "frontend": "node scripts/frontend.mjs",
    "worker": "node --env-file=.env src/worker/main.ts",
    "db:local": "node scripts/local-postgres.mjs start",
    "db:stop": "node scripts/local-postgres.mjs stop",
    "db:migrate": "node --env-file=.env scripts/migrate.ts",
    "db:seed": "node --env-file=.env scripts/seed.ts",
    "db:seed:inventory": "node --env-file=.env scripts/seed-inventory.ts",
    "db:seed:clinical": "node --env-file=.env scripts/seed-clinical.ts",
    "db:seed:daily": "node --env-file=.env scripts/seed-daily.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src scripts tests",
    "format": "biome format --write src scripts tests package.json tsconfig.json biome.json",
    "format:check": "biome format src scripts tests package.json tsconfig.json biome.json",
    "test": "node --test tests/unit.test.ts",
    "test:frontend": "node --test tests/frontend-server.test.mjs",
    "test:integration": "node --env-file=.env --test --test-concurrency=1 tests/integration.test.ts tests/inventory.test.ts tests/clinical.test.ts tests/daily.test.ts tests/financial.test.ts tests/exams.test.ts tests/preventive.test.ts tests/documents.test.ts tests/schedule.test.ts tests/portal.test.ts tests/purchases.test.ts tests/medical-record.test.ts tests/core-journeys.test.ts tests/payables.test.ts tests/terminal.test.ts tests/purchase-pricing.test.ts tests/acquisition-cost.test.ts tests/supplier-installments.test.ts tests/supplier-credit.test.ts tests/supplier-outflow.test.ts tests/medical-complements.test.ts tests/links-audit.test.ts tests/registry-corrections.test.ts tests/terminal-access.test.ts tests/clinical-corrections.test.ts tests/daily-corrections.test.ts tests/financial-corrections.test.ts tests/terminal-v1.test.ts",
    "benchmark:daily": "node --env-file=.env scripts/benchmark-daily.ts",
    "benchmark:clinical": "node --env-file=.env scripts/benchmark-clinical.ts",
    "benchmark:inventory": "node --env-file=.env scripts/benchmark-inventory.ts",
    "openapi": "node scripts/openapi.ts",
    "benchmark": "node --env-file=.env scripts/benchmark.ts",
    "check": "node scripts/check.mjs",
    "db:seed:financial": "node --env-file=.env scripts/seed-financial.ts",
    "benchmark:financial": "node --env-file=.env scripts/benchmark-financial.ts",
    "db:seed:exams": "node --env-file=.env scripts/seed-exams.ts",
    "benchmark:exams": "node --env-file=.env scripts/benchmark-exams.ts",
    "db:seed:preventive": "node --env-file=.env scripts/seed-preventive.ts",
    "benchmark:preventive": "node --env-file=.env scripts/benchmark-preventive.ts",
    "db:seed:documents": "node --env-file=.env scripts/seed-documents.ts",
    "benchmark:documents": "node --env-file=.env scripts/benchmark-documents.ts",
    "db:seed:schedule": "node --env-file=.env scripts/seed-schedule.ts",
    "benchmark:schedule": "node --env-file=.env scripts/benchmark-schedule.ts",
    "db:seed:portal": "node --env-file=.env scripts/seed-portal.ts",
    "benchmark:portal": "node --env-file=.env scripts/benchmark-portal.ts",
    "db:seed:purchases": "node --env-file=.env scripts/seed-purchases.ts",
    "check:purchases": "node scripts/check.mjs --purchases",
    "db:seed:medical": "node --env-file=.env scripts/seed-medical.ts",
    "check:medical": "node scripts/check.mjs --medical",
    "db:seed:core": "node --env-file=.env scripts/seed-core.ts",
    "check:journeys": "node scripts/check.mjs --journeys",
    "check:payables": "node scripts/check.mjs --payables",
    "db:seed:payables": "node --env-file=.env scripts/seed-payables.ts",
    "check:terminal": "node scripts/check.mjs --terminal",
    "db:seed:terminal": "node --env-file=.env scripts/seed-terminal.ts",
    "check:pricing": "node scripts/check.mjs --pricing",
    "db:seed:pricing": "node --env-file=.env scripts/seed-pricing.ts",
    "check:acquisition": "node scripts/check.mjs --acquisition",
    "db:seed:acquisition": "node --env-file=.env scripts/seed-acquisition.ts",
    "check:installments": "node scripts/check.mjs --installments",
    "db:seed:installments": "node --env-file=.env scripts/seed-installments.ts",
    "check:supplier-credit": "node scripts/check.mjs --supplier-credit",
    "db:seed:supplier-credit": "node --env-file=.env scripts/seed-supplier-credit.ts",
    "check:supplier-outflow": "node scripts/check.mjs --supplier-outflow",
    "db:seed:supplier-outflow": "node --env-file=.env scripts/seed-supplier-outflow.ts",
    "check:medical-complements": "node scripts/check.mjs --medical-complements",
    "db:seed:medical-complements": "node --env-file=.env scripts/seed-medical-complements.ts",
    "check:links-audit": "node scripts/check.mjs --links-audit",
    "db:seed:links-audit": "node --env-file=.env scripts/seed-links-audit.ts",
    "check:registry": "node scripts/check.mjs --registry",
    "db:seed:registry": "node --env-file=.env scripts/seed-registry-corrections.ts",
    "check:terminal-access": "node scripts/check.mjs --terminal-access",
    "db:seed:terminal-access": "node --env-file=.env scripts/seed-terminal-access.ts",
    "check:clinical-corrections": "node scripts/check.mjs --clinical-corrections",
    "db:seed:clinical-corrections": "node --env-file=.env scripts/seed-clinical-corrections.ts",
    "check:daily-corrections": "node scripts/check.mjs --daily-corrections",
    "db:seed:daily-corrections": "node --env-file=.env scripts/seed-daily-corrections.ts",
    "check:terminal-v1": "node scripts/check.mjs --terminal-v1",
    "check:financial-corrections": "node scripts/check.mjs --financial-corrections",
    "db:seed:financial-corrections": "node --env-file=.env scripts/seed-financial-corrections.ts"
  },
  "dependencies": {
    "@fastify/swagger": "9.8.1",
    "fastify": "5.12.4",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  },
  "optionalDependencies": {
    "@embedded-postgres/windows-x64": "17.10.0-beta.17"
  }
}
