{
  "cleanUrls": true,
  "functions": {
    "api/gateway.ts": {
      "maxDuration": 30,
      "includeFiles": "{src/**,scripts/hosted-session.ts}"
    }
  },
  "rewrites": [
    {
      "source": "/session",
      "destination": "/api/gateway?hvb_path=/session"
    },
    {
      "source": "/health",
      "destination": "/api/gateway?hvb_path=/health"
    },
    {
      "source": "/ready",
      "destination": "/api/gateway?hvb_path=/ready"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/gateway?hvb_path=/v1/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
